# Copy this file to .env and fill in your Supabase credentials
# Get these from: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Server-only — used by api/mcp.ts. Do NOT prefix with VITE_ (that would
# expose them to the client bundle). Not read by the browser app.
# SUPABASE_SERVICE_ROLE_KEY: Supabase Dashboard → Settings → API → service_role key.
# WIKI_MCP_TOKEN: any long random secret you generate; Claude sends it back as
#   a bearer token when you add this endpoint as a custom connector.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
WIKI_MCP_TOKEN=your-random-secret-here
